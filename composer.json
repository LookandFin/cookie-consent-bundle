{
    "name": "connectholland/cookie-consent-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for implementing Cookie Consent to comply to AVG/GDPR.",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.3",
        "symfony/asset": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/templating": "^6.4",
        "symfony/translation": "^8.0",
        "symfony/twig-bridge": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "twig/twig": "^2.6 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^12.1",
        "symfony/yaml": "^3.4 || ^4.2 || ^5.0 || ^6.0 || ^7.0"
    },
    "prefer-stable": true,
    "autoload": {
        "exclude-from-classmap": ["/Tests/"],
        "psr-4": {
            "ConnectHolland\\CookieConsentBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConnectHolland\\CookieConsentBundle\\Tests\\": "/Tests"
        }
    },
    "config": {
         "sort-packages": true
    }
}
